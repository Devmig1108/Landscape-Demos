# -------------------------------------------------------------------
# ISOLATION: Keep the parent WordPress site out of this folder
# -------------------------------------------------------------------
RewriteEngine On
# Because you are accessing this via lawnheros.com, this MUST be just /
RewriteBase / 

# 1. Force XML headers so Google stops rejecting the sitemap
<IfModule mod_mime.c>
    AddType application/xml .xml
</IfModule>

# 2. Reroute sitemap.xml to the PHP generator safely
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# -------------------------------------------------------------------
# SPIDER TRAP KILL-SWITCH 
# -------------------------------------------------------------------
# If a bot tries to dig 3 or more folders deep, kill it instantly.
RewriteCond %{REQUEST_URI} ^/([^/]+/){3,}
RewriteCond %{REQUEST_URI} !^/(css|images|js|includes)/ 
RewriteRule ^ - [R=404,L]

# 3. Trailing Slash Fix
RewriteCond %{REQUEST_URI} ^/+$
RewriteRule ^(.*)$ /index.php [L]